# Senarai rahsia. Satu contoh untuk dua fail (kedua-duanya gitignored):
#   .env      → PRODUKSI. Hanya dibaca oleh `bun run secrets:push`.
#   .env.dev  → LOKAL. Dibaca oleh `bun run dev` (wrangler dev --env-file .env.dev).
# Jangan sesekali letak nilai produksi dalam .env.dev.
# Fail ini juga sumber jenis rahsia (`bun run cf-typegen`) - tambah kunci baharu di sini.
# Kosong = ciri mati (docs/00000-foundation.md §4). Var bukan rahsia → wrangler.jsonc.

# Lokal sahaja: tindih var `production` dalam wrangler.jsonc. Diabaikan oleh secrets:push.
ENVIRONMENT=development

# Wajib, min 32 aksara. Produksi: SAMA dengan marc_go (token sedia ada kekal sah).
JWT_SECRET=

RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TOYYIBPAY_SECRET_KEY=
ONESIGNAL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
